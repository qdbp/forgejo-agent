#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: codex-role <role> [codex-args...]

examples:
  codex-role orch --version
  codex-role dev exec --help
EOF
  exit 2
}

[[ $# -ge 1 ]] || usage
role="$1"
shift

case "$role" in
  *[!a-zA-Z0-9_-]* | "") usage ;;
  *) ;;
esac

token_dir="${CODEX_ROLE_TOKEN_DIR:-$HOME/.config/forgejo-agent/creds}"
role_token="${token_dir}/codex-${role}.token"
explicit_token="${CODEX_ROLE_TOKEN_FILE:-}"

if [[ -n "$explicit_token" ]]; then
  token_file="$explicit_token"
elif [[ -r "$role_token" ]]; then
  token_file="$role_token"
else
  printf 'error: no readable token file for role %s\n' "$role" >&2
  printf 'checked: %s\n' "$role_token" >&2
  exit 1
fi

# systemd user services often lack user bin dirs in PATH; make sure our tools exist.
#
# Keep system dirs ahead of user dirs to avoid shadowing (e.g. a broken ~/.local/bin/python3).
new_path="${PATH:-/usr/local/bin:/usr/bin:/bin}"

# Remove any existing user-bin entries so we can append them deterministically.
filtered=""
IFS=':' read -r -a path_parts <<<"$new_path"
for part in "${path_parts[@]}"; do
  [[ -n "$part" ]] || continue
  case "$part" in
    "$HOME/bin" | "$HOME/.local/bin") continue ;;
    *) ;;
  esac
  if [[ ":${filtered}:" != *":${part}:"* ]]; then
    filtered="${filtered:+${filtered}:}${part}"
  fi
done
new_path="$filtered"

for d in "$HOME/bin" "$HOME/.local/bin"; do
  if [[ -d "$d" ]] && [[ ":${new_path}:" != *":${d}:"* ]]; then
    new_path="${new_path:+${new_path}:}${d}"
  fi
done

swarm_home="${SWARM_HOME:-$HOME/swarm}"

exec env \
  PATH="$new_path" \
  FORGEJO_PROFILE="$role" \
  FORGEJO_TOKEN_FILE="$token_file" \
  SWARM_HOME="$swarm_home" \
  /usr/bin/codex \
  -c "shell_environment_policy.set.PATH=\"$new_path\"" \
  -c "shell_environment_policy.set.FORGEJO_PROFILE=\"$role\"" \
  -c "shell_environment_policy.set.FORGEJO_TOKEN_FILE=\"$token_file\"" \
  -c "shell_environment_policy.set.SWARM_HOME=\"$swarm_home\"" \
  "$@"
