#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: codex-role <role> [codex-args...]

examples:
  codex-role orch --version
  codex-role dev exec --help
EOF
  exit 2
}

[[ $# -ge 1 ]] || usage
role="$1"
shift

case "$role" in
  *[!a-zA-Z0-9_-]* | "") usage ;;
  *) ;;
esac

token_dir="${CODEX_ROLE_TOKEN_DIR:-$HOME/.config/forgejo-agent/creds}"
role_token="${token_dir}/codex-${role}.token"
fallback_token="${HOME}/.config/forgejo-agent/token"

if [[ -r "$role_token" ]]; then
  token_file="$role_token"
elif [[ -r "$fallback_token" ]]; then
  token_file="$fallback_token"
else
  printf 'error: no readable token file for role %s\n' "$role" >&2
  printf 'checked: %s and %s\n' "$role_token" "$fallback_token" >&2
  exit 1
fi

exec env \
  FORGEJO_PROFILE="$role" \
  FORGEJO_TOKEN_FILE="$token_file" \
  /usr/bin/codex \
  -c "shell_environment_policy.set.FORGEJO_PROFILE=\"$role\"" \
  -c "shell_environment_policy.set.FORGEJO_TOKEN_FILE=\"$token_file\"" \
  "$@"
